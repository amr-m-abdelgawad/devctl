{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Reserved hexagonal port: adapters are expected to implement this later.
  // plugin-sdk.ts is a public entry; its re-exports have no in-repo importer.
  // e2e fixtures are programs devctl runs as services, not modules anything imports.
  // scripts/spikes are one-off measurement programs run by hand.
  // test/oracle/pre-branch is main@ed58322's log append path frozen verbatim as
  // the ingest oracle's reference. knip does not scan test/, so it needs no entry here.
  "ignore": ["src/ports/credential-provider.ts", "src/plugin-sdk.ts", "e2e/fixtures/**", "e2e/soak/**", "scripts/spikes/**"],
  "entry": [
    "web/main.tsx",
    "src/adapters/storage/log-worker.ts",
    "src/adapters/daemon/event-loop-watchdog-worker.ts"
  ],
  // Host tools spawned at runtime, not npm packages.
  "ignoreBinaries": ["explorer", "xdg-open", "vm_stat", "mkfifo"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "duplicates": "error",
    // Named values with no importer. Types stay off: barrels and RPC
    // contract types have no in-repo importer by design.
    "exports": "error",
    "nsExports": "off",
    "types": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "namespaceMembers": "off"
  }
}
