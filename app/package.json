{
  "name": "devctl",
  "version": "0.25.0",
  "description": "Local development orchestrator",
  "license": "MIT",
  "module": "src/bin.ts",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amr-m-abdelgawad/devctl.git"
  },
  "homepage": "https://github.com/amr-m-abdelgawad/devctl",
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "devctl": "./src/bin.ts"
  },
  "scripts": {
    "dev": "bun run src/bin.ts",
    "start": "bun run src/bin.ts",
    "test": "bun test",
    "e2e": "DEVCTL_E2E=1 bun test e2e",
    "e2e:setup": "bash e2e/setup.sh",
    "check:coverage": "bun scripts/check-coverage.ts",
    "test:npm-launcher": "node --test ../packaging/npm/devctl.test.cjs",
    "typecheck": "bunx tsc --noEmit && bun run typecheck:web",
    "typecheck:web": "bunx tsc --noEmit -p web/tsconfig.json",
    "build:web": "bun run scripts/build-web-assets.ts",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:dead": "knip-bun",
    "check:dup": "jscpd src scripts",
    "build:npm": "bun run scripts/build-npm-package.ts",
    "update:homebrew": "bun run scripts/update-homebrew-formula.ts",
    "sync-guide": "bun run scripts/sync-guide.ts"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "uplot": "^1.6.32"
  },
  "dependencies": {
    "@opentui/core": "^0.7.0",
    "@opentui/react": "^0.7.0",
    "cli-spinners": "^3.4.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "google-auth-library": "^11.3.2",
    "react": "^19.3.1",
    "yaml": "^2.9.1"
  }
}
