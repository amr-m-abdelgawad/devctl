{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/amr-m-abdelgawad/devctl/main/schema/devctl.config.schema.json",
  "title": "devctl configuration",
  "description": "Schema for .devctl/config.yaml (and merged modular YAML). Unknown fields are rejected at load time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Must be 1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Shown in the TUI header" }
      }
    },
    "google": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": "string" },
        "region": { "type": "string" }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "templates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/service" }
    },
    "services": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/service" }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/task" }
    },
    "proxy": { "$ref": "#/$defs/proxy" },
    "logs": { "$ref": "#/$defs/logs" },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "web": { "$ref": "#/$defs/web" },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refresh_threshold_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop_services_on_exit": { "type": "boolean" },
        "grace_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "type": "string" },
        "keymap": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extra_markers": { "type": "array", "items": { "type": "string" } },
        "extra_patterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "command": { "type": "string" }
            }
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "JS/TS module loaded when the supervisor starts"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional sources to add to the always-on set (process, defaults, vars, runtime). Typical: profile, dotenv, generated, keychain, secret_manager"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "description": "argv list preferred; a string is split on whitespace. Set service shell: true for pipes or redirects.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "portValue": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 65535 },
        { "type": "string", "pattern": "^(auto|[0-9]+)$" }
      ]
    },
    "ports": {
      "description": "Named map (http: 8000), list, single number, or auto",
      "oneOf": [
        { "$ref": "#/$defs/portValue" },
        { "type": "array", "items": { "$ref": "#/$defs/portValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/portValue" } }
      ]
    },
    "serviceEnvironment": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "defaults": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": { "type": "string" }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": { "type": "array", "items": { "type": "string" } },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "shell": { "type": "boolean" },
        "working_dir": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "environment": { "$ref": "#/$defs/serviceEnvironment" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": { "type": "string" },
        "description": { "type": "string" },
        "command": { "$ref": "#/$defs/command" },
        "shell": { "type": "boolean" },
        "working_dir": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/dependency" }
            ]
          }
        },
        "ports": { "$ref": "#/$defs/ports" },
        "environment": { "$ref": "#/$defs/serviceEnvironment" },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "http | tcp | process | command (plugins may add more)"
            },
            "url": { "type": "string" },
            "address": { "type": "string" },
            "command": { "$ref": "#/$defs/command" },
            "interval_seconds": { "type": "number", "minimum": 0 },
            "timeout_seconds": { "type": "number", "minimum": 0 },
            "start_period_seconds": { "type": "number", "minimum": 0 },
            "unhealthy_threshold": { "type": "integer", "minimum": 1 },
            "healthy_reset_threshold": { "type": "integer", "minimum": 1 }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "description": "Built-in user/service_account identity or a type registered by a plugin" },
            "mode": { "type": "string", "description": "Alias of type" },
            "service_account": { "type": "string" },
            "config": { "type": "object", "additionalProperties": true }
          }
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stdout": { "type": "boolean" },
            "stderr": { "type": "boolean" }
          }
        },
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "policy": { "type": "string", "description": "never | on_failure | always" },
            "max_retries": { "type": "integer", "minimum": 0 },
            "backoff_seconds": { "type": "number", "minimum": 0 }
          }
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wait_for_healthy": { "type": "boolean" },
            "timeout_seconds": { "type": "number", "minimum": 0 }
          }
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proxy": {
          "description": "Route fragments merged into the global proxy at load (names become <service> or <service>-<n>)",
          "oneOf": [
            { "$ref": "#/$defs/route" },
            { "type": "array", "items": { "$ref": "#/$defs/route" } }
          ]
        },
        "expose": {
          "description": "Expose this service through the proxy at a stable, host-based logical address (<service>.local) whose upstream port is resolved at request time. `true`, or an object with match/port overrides. Requires proxy.enabled.",
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "host": { "type": "string", "description": "Override the match host (default <service>.local)" },
                "port": { "type": "string", "description": "Named port to forward to (default http)" }
              }
            }
          ]
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "runtime": { "type": "string", "enum": ["docker", "podman"] },
            "ports": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 65535 } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "volumes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "watch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "paths": { "type": "array", "items": { "type": "string" }, "description": "Paths relative to the repository root. Never defaults to the whole repo." },
            "debounce_ms": { "type": "integer", "minimum": 0 },
            "ignore": { "type": "array", "items": { "type": "string" } }
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pre_start": { "$ref": "#/$defs/command" },
            "post_start": { "$ref": "#/$defs/command" }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "enum": ["service_started", "service_healthy"] }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "gateway": { "type": "boolean", "description": "Expose every HTTP-capable service (one with a port named http) through the proxy, as if each declared expose: true. Sugar over per-service expose." },
        "credentials": { "type": "string", "description": "Default authorized_user credentials file for IAP routes that omit auth.credentials (see route.auth.credentials)." },
        "listen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        "token_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/route" }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "transport": { "type": "string", "enum": ["http", "grpc"], "description": "http (default): shared HTTP/1.1 listener matched by host/path. grpc: a dedicated loopback HTTP/2 (h2c) listener on `listen` that forwards streams to `upstream` over h2+TLS, injecting the route's auth — for gRPC clients (e.g. a Temporal worker) behind IAP." },
        "listen": {
          "type": "object",
          "additionalProperties": false,
          "description": "Only for a grpc route: the loopback address the client dials.",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "service": { "type": "string", "description": "Address the upstream by service name instead of a fixed url; the proxy resolves the service's live port at request time." },
            "port": { "type": "string", "description": "Named port of the referenced service to forward to (default http)." }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "description": "none, iap, or service_account" },
            "audience": { "type": "string" },
            "service_account": { "type": "string" },
            "client_id": { "type": "string", "description": "Optional OAuth client ID used to mint IAP ID tokens instead of ADC's default client" },
            "client_secret": { "type": "string", "description": "Optional OAuth client secret. Use ${NAME} or ${env.NAME} to read from the environment at mint time." },
            "credentials": { "type": "string", "description": "Path to a gcloud authorized_user JSON (client_id/client_secret/refresh_token) used to mint IAP tokens for client_id, instead of default ADC. Keeps ADC intact for GCS/Firestore. ~, absolute, or repo-relative. Falls back to proxy.credentials." },
            "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra request headers injected alongside Authorization. ${token} in a value is replaced with the minted token (e.g. identity-token: ${token}). Applied only on iap/service_account routes." },
            "identity": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": { "type": "string" },
                    "service_account": { "type": "string" }
                  }
                }
              ]
            }
          }
        },
        "response_headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Headers added to every response on this route (overriding the upstream's), e.g. CORS Access-Control-Allow-*. A CORS preflight (OPTIONS with Access-Control-Request-Method) is answered directly with these headers instead of being forwarded to the upstream."
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_memory_events": { "type": "integer", "minimum": 1 },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "directory": { "type": "string" },
            "retention_days": { "type": "integer", "minimum": 0 },
            "max_session_logs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "description": "Opt-in OTLP/HTTP+JSON receiver. Off by default. Loopback only." },
            "listen": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host": { "type": "string" },
                "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
              }
            }
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Opt-in loopback telemetry web UI. Off by default. Read-only. Loopback only." },
        "listen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        }
      }
    }
  }
}
